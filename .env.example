# Copy to .env.local for local development. Never commit .env.local.

# ---------------------------------------------------------------- AI provider
#
# Which service answers model calls. The app is provider-agnostic: call sites
# ask for a role ("chunk", "question", "primary", "translate") and lib/ai.ts
# decides who serves it.
#
#   gateway    Vercel AI Gateway (default). Needs a positive credit balance —
#              including with bring-your-own-key.
#   openai     Direct to OpenAI. Needs OPENAI_API_KEY.
#   anthropic  Direct to Anthropic. Needs ANTHROPIC_API_KEY.
#   local      Any OpenAI-compatible server (Ollama, LM Studio, vLLM). Free
#              and offline; output quality is visibly lower.
AI_PROVIDER=openai

# Whichever provider you chose above.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=

# For AI_PROVIDER=local. Ollama's OpenAI-compatible endpoint by default.
# AI_LOCAL_BASE_URL=http://localhost:11434/v1
# AI_LOCAL_API_KEY=local

# Per-role model overrides. Names are provider-specific, so these matter most
# when a default here is wrong for your account — changing one is an env edit,
# not a code change.
#
#   AI_MODEL           tutor replies to students        (quality matters most)
#   AI_CHUNK_MODEL     splitting an upload into chunks  (mechanical; cheap tier)
#   AI_QUESTION_MODEL  generating practice questions
#   AI_TRANSLATE_MODEL Chinese translation
#
# openai defaults:    gpt-5.4 / gpt-5.4-mini / gpt-5.4-mini / gpt-5.4-mini
# anthropic defaults: claude-sonnet-5 / claude-haiku-4.5 / ...
# local defaults:     llama3.1 for every role
#
# AI_MODEL=
# AI_CHUNK_MODEL=
# AI_QUESTION_MODEL=
# AI_TRANSLATE_MODEL=

# How many model calls run at once. Two by default, because unbounded fan-out
# rate-limits itself: approving a deck fires one call per section.
# AI_MAX_CONCURRENCY=2

# ------------------------------------------------------------------- Supabase
#
# From your Supabase project's API settings. The service-role key bypasses RLS
# and must never reach the browser — server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
